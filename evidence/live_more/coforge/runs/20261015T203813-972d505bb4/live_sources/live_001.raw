<script nonce="Iw4XFG53vOwcexJ+ETrLgQ==">
  document.addEventListener("DOMContentLoaded", function () {
    const bottomNavbarWrapper = document.querySelector(".bottom-navbar-wrapper");

    if (!bottomNavbarWrapper) return;

    function toggleNavClass() {
      const scrollPosition = window.innerHeight + window.scrollY;
      const pageHeight = document.documentElement.scrollHeight;

      if (scrollPosition >= pageHeight - 5) {
        bottomNavbarWrapper.classList.add("hide-nav");
      } else {
        bottomNavbarWrapper.classList.remove("hide-nav");
      }
    }

    window.addEventListener("scroll", toggleNavClass);
    window.addEventListener("resize", toggleNavClass);

    toggleNavClass();
  });
</script>
