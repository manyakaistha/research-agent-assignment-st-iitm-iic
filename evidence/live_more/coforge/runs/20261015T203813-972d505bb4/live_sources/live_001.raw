<script nonce="Iw4XFG53vOwcexJ+ETrLgQ==">
  const currentLang = "en";
  let isOpen = false;
  let activeSubmenu = null;

  function getMobileNavbar() {
    return document.querySelector(".desktop-hide #navbarWrapper");
  }

  function renderLogo() {
    const wrapper = getMobileNavbar();
    if (!wrapper) return;

    const logoArea = wrapper.querySelector("#logoArea");
    if (!logoArea) return;

    logoArea.innerHTML = `
        <a href="/" style="display:flex; align-items:center;">
          <img
            src="https://logo-s3.s3.us-east-1.amazonaws.com/Chameleon/homepage/coforge-logo.svg"
            alt="coforge logo"
            width="118"
            height="18"
            class="mobile-navbar-logo"
          />
  </a>
      `;
  }

  function renderBackButton() {
    const wrapper = getMobileNavbar();
    if (!wrapper) return;

    const logoArea = wrapper.querySelector("#logoArea");
    if (!logoArea) return;

    logoArea.innerHTML = `
        <button class="mobile-navbar-link" type="button" id="mobileBackBtn">
          <span class="relative nav-back-arrow-mobile">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
              <g transform="scale(-1,1) translate(-24, 0)">
                <path d="M20.78 12.53 14.03 19.28a.996.996 0 0 1-1.41 0 .996.996 0 0 1 0-1.41l5.47-5.47H3.75a.999.999 0 1 1 0-2h14.34l-5.47-5.47a.996.996 0 1 1 1.41-1.41l6.75 6.75c.07.07.13.15.17.24.04.09.06.19.06.28s-.02.19-.06.28a.998.998 0 0 1-.17.24Z" fill="#F2674E"></path>
  </g>
  </svg>
  </span>
  </button>
      `;

    logoArea.querySelector("#mobileBackBtn")?.addEventListener("click", closeSubmenu);
  }

  function renderToggleLabel() {
    const wrapper = getMobileNavbar();
    if (!wrapper) return;

    const toggleLabel = wrapper.querySelector("#toggleLabel");
    if (!toggleLabel) return;

    toggleLabel.style.pointerEvents = "none";

    const isSpanish = "en" === "es";
    const closeLabel = isSpanish ? "Cerrar" : "Close";
    const menuLabel = isSpanish ? "Menú" : "Menu";

    toggleLabel.innerHTML = isOpen
      ? `
      <div class="mobile-navbar-close" style="display:flex; align-items:center; gap:6px; pointer-events:none;">
        ${closeLabel}
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
          <path d="M16.24 16.24a.996.996 0 0 1-1.41 0L12 13.41l-2.83 2.83a.996.996 0 1 1-1.41-1.41L10.59 12 7.76 9.17a.996.996 0 1 1 1.41-1.41L12 10.59l2.83-2.83a.996.996 0 1 1 1.41 1.41L13.41 12l2.83 2.83c.39.38.39 1.02 0 1.41Z" fill="#F2674E"/>
  </svg>
  </div>
    `
    : `
      ${menuLabel}
      <img src="https://logo-s3.s3.us-east-1.amazonaws.com/Chameleon/homepage/Plus-icon.svg" alt="open" width="16" height="16"/>
    `;
  }

  function toggleMenu() {
    const wrapper = getMobileNavbar();
    if (!wrapper) return;

    isOpen = !isOpen;
    activeSubmenu = null;

    wrapper.classList.toggle("open", isOpen);
    document.body.classList.toggle("nav-opened", isOpen);

    updateSubmenus();
    renderLogo();
    renderToggleLabel();
  }

  function openSubmenu(name) {
    const wrapper = getMobileNavbar();
    if (!wrapper) return;

    activeSubmenu = name;

    updateSubmenus();
    renderBackButton();
  }

  function closeSubmenu() {
    const wrapper = getMobileNavbar();
    if (!wrapper) return;

    activeSubmenu = null;

    updateSubmenus();
    renderLogo();
  }

  function updateSubmenus() {
    const wrapper = getMobileNavbar();
    if (!wrapper) return;

    const mainMenu = wrapper.querySelector("#mainMenu");
    if (!mainMenu) return;

    mainMenu.classList.toggle("slide-out", activeSubmenu !== null);

    wrapper.querySelectorAll(".mobile-navbar-content.sub-menu").forEach((sub) => {
      const id = sub.id || "";
      const name = id.replace("sub-", "");

      sub.classList.toggle("slide-in", name === activeSubmenu);
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    /**
       * MOBILE NAVBAR
       * DO NOT TOUCH.
       */
    const wrapper = getMobileNavbar();

    if (wrapper) {
      const toggleBtn = wrapper.querySelector("#toggleBtn");

      if (toggleBtn) {
        toggleBtn.removeAttribute("onclick");
        toggleBtn.setAttribute("type", "button");
        toggleBtn.addEventListener("click", toggleMenu);
      }

      wrapper.querySelectorAll("[data-submenu]").forEach((item) => {
        item.setAttribute("type", "button");
        item.addEventListener("click", () => {
          openSubmenu(item.dataset.submenu);
        });
      });

      renderLogo();
      renderToggleLabel();
    }

    /**
       * DESKTOP NAVBAR
       */
    const desktopNavbar = document.querySelector(".bottom-desktop-navbar");

    if (desktopNavbar) {
      const bottomNavbarWrapper = desktopNavbar.querySelector(".bottom-navbar-wrapper");
      const desktopLinks = desktopNavbar.querySelectorAll(".link-toggle");

      const desktopSubmenus = [
        desktopNavbar.querySelector("#subMenuWrapperCapabilities"),
        desktopNavbar.querySelector("#subMenuWrapperIndustries"),
        desktopNavbar.querySelector("#subMenuWrapperWhatWeKnow"),
        desktopNavbar.querySelector("#subMenuWrapperWhoWeAre")
      ];

      const plusIcon = "https://logo-s3.s3.us-east-1.amazonaws.com/Chameleon/homepage/Plus-icon.svg";
      const closeIcon = "https://logo-s3.s3.us-east-1.amazonaws.com/Chameleon/homepage/Close-icon.svg";

      function setDesktopIcon(link, isOpen) {
        const icon = link.querySelector(".desktop-menu-icon");

        if (!icon) return;

        icon.src = isOpen ? closeIcon : plusIcon;
        icon.alt = isOpen ? "x" : "+";
      }

      // New design animates the panel closed; the old one closes at once.
      const animateClose = false;
      let closeTimer = null;

      function clearSubmenus() {
        window.clearTimeout(closeTimer);
        desktopSubmenus.forEach((submenu) => {
          if (!submenu) return;
          submenu.classList.remove("expanded", "is-swap", "is-closing");
        });
        if (bottomNavbarWrapper) {
          bottomNavbarWrapper.classList.remove("expanded", "is-closing");
        }
      }

      function closeDesktopSubmenus(animated) {
        const open = desktopSubmenus.find((submenu) => submenu && submenu.classList.contains("expanded"));

        if (animated && animateClose && open && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          open.classList.add("is-closing");
          if (bottomNavbarWrapper) bottomNavbarWrapper.classList.add("is-closing");
          closeTimer = window.setTimeout(clearSubmenus, 350);
        } else {
          clearSubmenus();
        }

        desktopLinks.forEach((link) => {
          link.classList.remove("active-link");

          const icon = link.querySelector(".menu-icon");
          if (icon) {
            icon.classList.remove("rotated");
          }
        });

      }

      desktopLinks.forEach((link, index) => {
        link.addEventListener("click", function (event) {
          const submenuIndex = index - 1;
          const submenu = desktopSubmenus[submenuIndex];

          if (!submenu) return;

          event.preventDefault();

          const isCurrentlyOpen = submenu.classList.contains("expanded") && !submenu.classList.contains("is-closing");
          const panelOpen = !!bottomNavbarWrapper && bottomNavbarWrapper.classList.contains("expanded") && !bottomNavbarWrapper.classList.contains("is-closing");

          closeDesktopSubmenus(isCurrentlyOpen);

          if (!isCurrentlyOpen) {
            submenu.classList.toggle("is-swap", panelOpen);
            submenu.classList.add("expanded");
            link.classList.add("active-link");

            const icon = link.querySelector(".menu-icon");
            if (icon) {
              icon.classList.add("rotated");
            }

            if (bottomNavbarWrapper) {
              bottomNavbarWrapper.classList.add("expanded");
            }
          }
        });
      });

      document.addEventListener("click", function (event) {
        // The dark backdrop is the wrapper's ::before, so a click on it targets the wrapper itself.
        if (!desktopNavbar.contains(event.target) || (animateClose && event.target === bottomNavbarWrapper)) {
          closeDesktopSubmenus(true);
        }
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          closeDesktopSubmenus(true);
        }
      });
    }

    /**
       * HIDE NAV AT PAGE BOTTOM
       */
    const navBars = document.querySelectorAll(".bottom-navbar-wrapper, .mobile-navbar-wrapper");

    if (navBars.length) {
      function toggleNavClass() {
        const scrollPosition = window.innerHeight + window.scrollY;
        const pageHeight = document.documentElement.scrollHeight;
        // A page that doesn't scroll is always "at the bottom"; the new design keeps the nav there.
        const scrolls = true;
        const atBottom = scrolls && scrollPosition >= pageHeight - 5;

        navBars.forEach((bar) => bar.classList.toggle("hide-nav", atBottom));
      }

      window.addEventListener("scroll", toggleNavClass);
      window.addEventListener("resize", toggleNavClass);

      toggleNavClass();
    }
  });

  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".language-switcher-wrapper").forEach(function (wrapper) {
      var trigger = wrapper.querySelector(".globe_class");
      var list = wrapper.querySelector(".lang_list_class");
      if (!trigger || !list) return;

      if (!list.querySelector(".lang_list_label")) {
        var label = document.createElement("li");
        label.className = "lang_list_label";
        label.textContent = currentLang === "es" ? "Idioma" : "Language";
        list.insertBefore(label, list.firstChild);
      }

      if (!trigger.querySelector(".globe_class__text")) {
        var textSpan = document.createElement("span");
        textSpan.className = "globe_class__text";
        textSpan.textContent = currentLang === "es" ? "ESP" : (currentLang === "pt" ? "PT" : currentLang.split("-")[0].toUpperCase());
        trigger.insertBefore(textSpan, trigger.firstChild);
      }

      trigger.addEventListener("click", function (event) {
        event.stopPropagation();
        wrapper.classList.toggle("is-open");
      });
    });

    document.addEventListener("click", function () {
      document.querySelectorAll(".language-switcher-wrapper.is-open").forEach(function (wrapper) {
        wrapper.classList.remove("is-open");
      });
    });
  });
</script>
